# Alleen voorbeeldnamen; zet hier NOOIT echte sleutels in Git.
SCHITTER_ENV=production
SCHITTER_STORAGE_DIR=/var/data
SCHITTER_SESSION_SECRET=maak-dit-op-render-aan
SCHITTER_SETUP_CODE=een-eenmalige-lange-geheime-code

# Optioneel, voor de AI-assistent (zoeken, medewerker-/bedrijfsmiddel-intake,
# actiecentrum-samenvatting). Leeg laten = de AI-functies blijven uitgeschakeld
# (de rest van de app werkt gewoon door). Let op: dit bestand wordt NIET
# automatisch ingelezen (er zit geen dotenv-afhankelijkheid in dit project) -
# het is alleen documentatie van de namen. Zet de waarden lokaal zelf klaar,
# bijvoorbeeld met `setx GROQ_API_KEY "..."` in een Windows-terminal (daarna
# opnieuw inloggen of een nieuw terminalvenster openen voordat je
# START_WINDOWS.bat start), of geef ze mee bij Render als environment
# variable. Test dit eerst lokaal met verzonnen testmedewerkers voordat je
# hier ooit een omgeving met echte gegevens aan koppelt.
#
# Groq (GROQ_API_KEY) is de vaste primaire AI-dienst; Gemini (GEMINI_API_KEY)
# is de vaste fallback en wordt alleen automatisch gebruikt als Groq zijn
# gratis quotum heeft bereikt. Er is geen providerkeuze in de app - de
# volgorde ligt vast in de code (Groq -> Gemini -> duidelijke melding als
# beide hun quotum bereikt hebben). Het gebruikte Groq-model staat centraal
# als GROQ_MODEL bovenaan de AI-sectie in app.py.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optioneel, voor de Orthotheek-module (automatische omslagfoto + titel/
# auteur/uitgever op basis van ISBN). Leeg laten = de opzoeking werkt nog
# steeds (Open Library heeft geen sleutel nodig), maar Google Books geeft
# anonieme verzoeken een laag quotum dat in de praktijk snel een 429
# ("Too Many Requests") oplevert. Gratis aan te maken: Google Cloud Console
# -> APIs & Services -> Credentials -> Create credentials -> API key (geen
# creditcard/facturering nodig voor dit gebruik). Zelfde kanttekening als
# hierboven: dit bestand wordt niet automatisch ingelezen, alleen ter
# documentatie - zet 'm lokaal met `setx` of bij Render als environment
# variable.
SCHITTER_GOOGLE_BOOKS_API_KEY=
